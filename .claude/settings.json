{

  "includeCoAuthoredBy": false,
  "attribution": { "commit": "", "pr": "" },
  "env": { "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "50" },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ],
    "allow": [
      "Bash(graft:*)",
      "Bash(python tools/doctor.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.cjs\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
