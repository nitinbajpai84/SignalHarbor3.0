# Copy to .env and fill in. Never commit .env (git ignores it). tools/doctor.py checks the required names.
# Every value here is empty or a safe default. Names only: no real secret is in this file.

# ---- Mode and paths ----
# SH_MODE: dev (local, default) or prod (production: Postgres and Redis, real-mode guards). Required.
SH_MODE=dev
# SH_DATA_ROOT: folder for company data, accounts and seed credentials. Local default ./data (git-ignored). Required.
SH_DATA_ROOT=./data
# SH_SESSION_SECRET: signs login cookies. Required. Use a random string of 32+ characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))".
SH_SESSION_SECRET=
# SH_EGRESS_DEFAULT: internet access for a new company: off (default) or on. Leave off unless a customer asks.
SH_EGRESS_DEFAULT=off
# SH_PUBLIC_BASE_URL: public address written into links in emails, e.g. https://your-app.example. Set in production; without it the request Host header is used.
SH_PUBLIC_BASE_URL=
# SH_SCHEDULER: background scheduler, on (default) or off. Set off for test servers.
SH_SCHEDULER=on
# SH_ROUTER: model task router, on (default) or off.
SH_ROUTER=on
# SH_EMBED_MODEL: local embedding model for document search. Default BAAI/bge-small-en-v1.5, downloaded once, free.
SH_EMBED_MODEL=BAAI/bge-small-en-v1.5
# SH_MCP_TOKEN: token for the local MCP server (sh_platform/mcp). Optional. Use a random string.
SH_MCP_TOKEN=
# SH_SMTP_URL: outgoing email, smtp://user:password@host:587 (STARTTLS). Optional; without it no email is sent.
SH_SMTP_URL=
# G5 Web Push (VAPID). Optional; simple mode makes a dev pair in <data root>/_control/vapid_dev.json when these are empty, production mode needs them.
# Keys are base64url: the public key is the 65-byte uncompressed point, the private key the 32-byte value. SH_PUSH_HOSTS adds push service hosts (comma separated).
SH_VAPID_PUBLIC_KEY=
SH_VAPID_PRIVATE_KEY=
SH_VAPID_SUBJECT=
SH_PUSH_HOSTS=
# G5 morning email: local time (HH:MM) after which the day's note is written, default 07:00. Without SH_SMTP_URL it lands in the company's outbox folder.
SH_MORNING_EMAIL_AT=

# ---- Production database and queue (production mode only) ----
# DATABASE_URL: Postgres URL. Empty = simple local mode. Railway sets it from its Postgres service. Local example: see docker-compose.yml.
DATABASE_URL=
# REDIS_URL: Redis URL. Empty = simple local mode. Railway sets it from its Redis service. Local example: see docker-compose.yml.
REDIS_URL=

# ---- AI model keys (at least one) ----
# GOOGLE_API_KEY: Gemini model key, free for development from Google AI Studio. Also the speech key (see Speech below).
GOOGLE_API_KEY=
# OPENROUTER_API_KEY: OpenRouter key, one key for many models, paid per use, from the OpenRouter keys page.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY: direct provider key from the provider's developer console. Only tools/doctor.py checks it today; no model adapter reads it yet.
ANTHROPIC_API_KEY=
# SH_JEV_API_KEY: key for the fast chat path (sh_platform/v1/chat_fastpath.py). Optional; empty when not set.
SH_JEV_API_KEY=
# SH_MODEL_PROVIDER: model provider the gateway uses: gemini, openrouter or off. Empty = whichever key is set (Gemini first). off switches all model calls off.
SH_MODEL_PROVIDER=
# SH_MODEL_NAME: one model id for every tier. Empty = the provider's default model.
SH_MODEL_NAME=

# ---- Real-mode settings (tiers and their overrides) ----
# SH_ALLOW_REAL_MODE: set 1 to allow real (live model and data) mode in production. Empty = not allowed.
SH_ALLOW_REAL_MODE=
# SH_ENABLE_SUPERADMIN: set 1 to enable the super admin in production. Empty = off.
SH_ENABLE_SUPERADMIN=
# SH_MODEL_FAST: model id for the fast tier. Empty = SH_MODEL_NAME or the provider default.
SH_MODEL_FAST=
# SH_MODEL_FAST_PROVIDER: provider for the fast tier (gemini, openrouter or off). Empty = SH_MODEL_PROVIDER.
SH_MODEL_FAST_PROVIDER=
# SH_MODEL_FAST_ALT: alternative model for the fast tier, used on fallback. Empty = fall back to the next tier up.
SH_MODEL_FAST_ALT=
# SH_MODEL_SPECIALIST: model id for the specialist tier. Empty = SH_MODEL_NAME or the provider default.
SH_MODEL_SPECIALIST=
# SH_MODEL_SPECIALIST_PROVIDER: provider for the specialist tier. Empty = SH_MODEL_PROVIDER.
SH_MODEL_SPECIALIST_PROVIDER=
# SH_MODEL_SPECIALIST_ALT: alternative model for the specialist tier, used on fallback. Empty = next tier up.
SH_MODEL_SPECIALIST_ALT=
# SH_MODEL_MANAGER: model id for the manager tier. Empty = SH_MODEL_NAME or the provider default.
SH_MODEL_MANAGER=
# SH_MODEL_MANAGER_PROVIDER: provider for the manager tier. Empty = SH_MODEL_PROVIDER.
SH_MODEL_MANAGER_PROVIDER=
# SH_MODEL_MANAGER_ALT: alternative model for the manager tier, used on fallback. Empty = next tier up.
SH_MODEL_MANAGER_ALT=

# ---- Speech (module 1 voice; optional, typing works without it) ----
# GOOGLE_API_KEY (above) is the speech key too. Without it speech is off and typing is used.
# SH_SPEECH_PROVIDER: voice provider: gemini, stub or off. Empty = gemini when GOOGLE_API_KEY is set, else stub.
SH_SPEECH_PROVIDER=
# SPEECH_PROVIDER: older name of SH_SPEECH_PROVIDER, still read. Use the SH_ name.
SPEECH_PROVIDER=
# SH_SPEECH_IN_PROD: set 1 to allow Gemini speech in production (the free tier is for development and demos). Empty = off in production.
SH_SPEECH_IN_PROD=

# ---- Market data (optional, free keys) ----
# FRED_API_KEY: St. Louis Fed economic data key, free from the FRED API key page. Without it the live FRED pull is skipped.
FRED_API_KEY=
# FINNHUB_API_KEY: market news and index data key, free tier from finnhub.io. Without it the live Finnhub pull is skipped.
FINNHUB_API_KEY=

# ---- Demo ----
# SH_DEMO_PASSWORD: one shared password for the demo accounts on first boot, 12+ characters. Optional. Set on the host; the owner shares it separately. Never commit it.
SH_DEMO_PASSWORD=

# ---- Set by the host (Railway), not by you locally ----
# RAILWAY_ENVIRONMENT: set by Railway. tools/seed_demo_boot.py uses it to protect the data volume.
RAILWAY_ENVIRONMENT=
# PORT: web port. Railway sets it. Empty locally = 8200 (tools/start.sh).
PORT=

# ---- Other: used by one script or by the warehouse job at a client ----
# SH_WAREHOUSE: path to the company warehouse file, read by the generated schedule script at the client site.
SH_WAREHOUSE=

# ---- Tests, live-test scripts and video tools (not needed to run the app) ----
# TEST_DATABASE_URL: Postgres URL for the production-mode tests (tests/v1/test_w3_two_modes.py). Empty = those tests are skipped.
TEST_DATABASE_URL=
# TEST_REDIS_URL: Redis URL for the production-mode tests. Empty = those tests are skipped.
TEST_REDIS_URL=
# SH_TEST_BASE: base URL for the contract tests. Default http://127.0.0.1:8200.
SH_TEST_BASE=
# SH_WRITE_FIXTURES: set 1 to rewrite recorded test fixtures. Never set in normal runs.
SH_WRITE_FIXTURES=
# SH_RERECORD: space-separated list of video clip numbers to record again (tools/video).
SH_RERECORD=
# SH_FILM_ENV, SH_FILM_PORT, SH_FILM_NEW: video tools: data folder name, port and new-script file. Empty = tool defaults.
SH_FILM_ENV=
SH_FILM_PORT=
SH_FILM_NEW=
# SH_SERVE_PORT, SH_SERVE_DATA: port and data folder for the video tools' test server. Empty = tool defaults.
SH_SERVE_PORT=
SH_SERVE_DATA=
# UC5_BASE, UC6_BASE, UC8_BASE: base URLs for the live UC test scripts. Empty = the script default port.
UC5_BASE=
UC6_BASE=
UC8_BASE=
# UC6_ENV, UC6_SHOTS, UC6_TMP: data folder, screenshot folder and scratch folder for the UC6 script. Empty = script defaults.
UC6_ENV=
UC6_SHOTS=
UC6_TMP=
# N: how many characters the UC8 script prints per response. Empty = 3000.
N=
# X1_DUMP: path prefix for the full role-matrix dump written by tests/auth/test_role_matrix.py. Empty = no dump.
X1_DUMP=
