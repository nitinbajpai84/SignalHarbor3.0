  "cards": [
    {
      "dot": "cyan",
      "title": "Three planes, as built",
      "items": [
        "Control plane: companies, module switches, industry packs. It holds no company data",
        "Module plane: modules 1 to 3 and their agents, the same code for every company; a module talks to another only through its signed output",
        "Company data plane: data/<company>/ holds the profile, interviews, signed outputs, context shelves, memory and the run log. Another company's plane fails closed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Bring what you have",
      "items": [
        "Nine standard inputs, several files per tile, read on the machine into the company profile; every value names its source",
        "A profile person is linked to a sign-in account only by the company admin; an email match is a suggestion the admin confirms",
        "Module 1 drafts the session and each linked person's notes from the profile and their interview; module 3 takes samples and reported figures from it"
      ]
    },
    {
      "dot": "rose",
      "title": "One exit, four guards",
      "items": [
        "Internal tools return counts and field names, never rows; groups under five are not shown",
        "The minimiser keeps only what the question needs; names become tokens",
        "The gateway allows only listed destinations, blocks names and raw records, and logs every call without content"
      ]
    },
    {
      "dot": "orange",
      "title": "Signed and read-only",
      "items": [
        "Module 1 ends in a signed charter, module 2 in a signed baseline, module 3 in a signed phased plan",
        "Each module starts from the previous signed output; signed content is read-only and a draft never overwrites a person's edit",
        "Restricted measures and samples are masked per viewer on module 3 screens and in its signed plan; module 2's lean owner pages are not landed yet"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent memory (A-048 to A-051)",
      "items": [
        "Today: the last turns of the current conversation, plus documents, the profile and signed outputs as long-term context",
        "MEM-1 (being built): the memory kernel. MEM-2 wires North, Lens and Nira to it and adds the person's own screen",
        "Planned: person memory used in that person's conversations, which they can read, correct or delete; a company digest with no names or attribution, used by that agent with anyone; never anonymous notes, restricted topics or figures"
      ]
    },
    {
      "dot": "amber",
      "title": "Where the build stands",
      "items": [
        "Landed: LI-PROFILE, LI-INTERVIEW, LI-M1, LI-M3, LI-LINK, LI-MULTI",
        "Not landed: LI-M2, the lean module 2 owner pages (review round 5, three blocking findings on who holds a part); module 2's earlier screens run as before",
        "Building: MEM-1. Next: MEM-2, LI-OUTCOMES, LI-E2E. Later: MEM-3 lessons into packs"
      ]
    }
  ]
