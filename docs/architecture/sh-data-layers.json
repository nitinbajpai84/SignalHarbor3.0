  "cards": [
    {
      "dot": "amber",
      "title": "Lineage and impact",
      "items": [
        "A change to a silver table lights every gold table built from it, and every dashboard and report that reads those.",
        "Example: a change to valuations in Observations lights the metric and calculation tables, then the Consume views."
      ]
    },
    {
      "dot": "cyan",
      "title": "Company additions",
      "items": [
        "Span proposes an extra table or column. The head of data approves it. It goes in as a new model version, never edited in place."
      ]
    }
  ]
