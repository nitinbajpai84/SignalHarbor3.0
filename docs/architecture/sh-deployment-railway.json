  "cards": [
    {
      "dot": "amber",
      "title": "Simple mode vs production mode",
      "items": [
        "Simple mode (no DATABASE_URL, no REDIS_URL): one process, JSON files and DuckDB on the volume, jobs run in the request.",
        "Production mode (both set): state moves to Postgres, jobs to Redis, and the worker runs in the same container."
      ]
    },
    {
      "dot": "cyan",
      "title": "Deploy and keys",
      "items": [
        "Railway builds the Dockerfile on each push; tools/start.sh seeds an empty volume, never wipes it.",
        "Keys are Railway variables named by env name (for example the model key and the market data keys); never in the repo, the chat or the logs."
      ]
    }
  ]
