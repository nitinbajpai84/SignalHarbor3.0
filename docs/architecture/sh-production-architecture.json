  "cards": [
    { "dot": "amber", "title": "Why change (as is)", "items": [
      "One process: a restart drops every login, rate count and breaker state",
      "Model calls and catalogue scans run inside the web process",
      "A second process cannot share files safely: locks are per process",
      "Screens fetch once and never hear about changes made elsewhere"
    ] },
    { "dot": "cyan", "title": "One switch, two modes", "items": [
      "No DATABASE_URL and no REDIS_URL: simple mode, exactly today",
      "Both set: production mode, Postgres + Redis + worker",
      "Routes, agents and tests call the adapters, never the backends",
      "The parity checker runs the 10 use-case checkers in both modes"
    ] },
    { "dot": "emerald", "title": "Safe under load", "items": [
      "Version column on every editable record: a stale save gets 409",
      "Idempotency key on writes: a double click saves once",
      "Outbox row in the same transaction: no change without its event",
      "Jobs survive a worker crash and run again safely"
    ] }
  ]
