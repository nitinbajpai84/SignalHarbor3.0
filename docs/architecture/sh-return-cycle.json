  "cards": [
    {
      "dot": "cyan",
      "title": "Who signs each stage",
      "items": [
        "Notice: nobody signs; North may reject a pattern the evidence breaks, with the reason",
        "Decide: the sponsor signs the charter; Build: the head of department approves before the data engineer builds",
        "Prove: the organiser confirms the weekly report and the verdict"
      ]
    },
    {
      "dot": "emerald",
      "title": "The loop closes",
      "items": [
        "Run: the Watcher reads runs, alerts and feeds and passes patterns to the radar",
        "Prove: a hypothesis that fails goes back to the radar with what was learned, and the people who raised the signal get a receipt"
      ]
    }
