 "cards": [
  {
   "dot": "emerald",
   "title": "Does every question leave the company?",
   "items": [
    "No. Figures are answered inside: tools read the company's own warehouse and return totals, never rows",
    "Only a short, trimmed prompt goes to the model, with names swapped for tokens; the answer is mapped back inside",
    "Files, rows and raw records never leave; a group smaller than five is never shown",
    "Strictest option: a private model inside the client's cloud, so no prompt leaves at all"
   ]
  },
  {
   "dot": "rose",
   "title": "The four guards, in order",
   "items": [
    "1 Internal tools: read-only, counts and totals only",
    "2 Minimiser: keeps only the fields the question needs",
    "3 Pseudonymiser: company, people, fund and counterparty names become tokens; the vault stays inside",
    "4 Egress gateway: allowlisted destinations only, blocks any payload with a vault name or a raw record, logs every call"
   ]
  },
  {
   "dot": "cyan",
   "title": "Security checks by layer",
   "items": [
    "Control plane: generic agents, packs and playbooks only; versioned; no company data or keys",
    "Module plane: sign-in, a role on every route (refused unless declared), named sign-off at each step",
    "Data plane: one company per plane, read-only tools, run ID on every load, taught notes kept here",
    "Exit: allowlist, name and row blocker, full call log; internet is a switch per company, off by default"
   ]
  },
  {
   "dot": "violet",
   "title": "Who trains the agents",
   "items": [
    "Span: head of data, data engineer, admin",
    "Lumen: owner, head of data, admin",
    "Tally: owner, sponsor, approver, admin; North: admin",
    "What a company teaches stays in its own data plane; only generic playbooks live in the control plane",
    "Taught material suggests; it is never an instruction and never the source of a figure"
   ]
  }
 ]
