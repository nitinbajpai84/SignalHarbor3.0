                "layer": "gold",
                "purpose": "Month-end balances by entity, providing the latest market value for each holding within the month.",
                "columns": [],
                "sql": "CREATE TABLE gold_investment_report_balances_monthly_by_entity AS WITH latest AS (SELECT le.entity_code, le.entity_name, ps.instrument_id, ps.source_market_value, ps.currency, ps.position_date, ROW_NUMBER() OVER (PARTITION BY le.entity_code, ps.instrument_id, ps.currency, DATE_TRUNC('month', ps.position_date) ORDER BY ps.position_date DESC, ps.recorded_at DESC) AS rn FROM position_snapshots ps JOIN portfolios p ON ps.portfolio_id = p.id JOIN legal_entities le ON p.legal_entity_id = le.id) SELECT DATE_TRUNC('month', position_date) AS month, entity_code, entity_name, currency, SUM(source_market_value) AS total_market_value FROM latest WHERE rn = 1 GROUP BY 1, 2, 3, 4;",
                "depends_on": [
