                "purpose": "Month-end balances by entity, showing the latest market value for each holding within the month.",
                "columns": [],
                "sql": "create table gold_investment_report_balances_monthly_by_entity as\nwith latest as (\n  select\n    ps.portfolio_id,\n    ps.instrument_id,\n    le.entity_name as entity,\n    ps.source_market_value as market_value,\n    ps.position_date,\n    row_number() over (partition by ps.portfolio_id, ps.instrument_id, date_trunc('month', ps.position_date) order by ps.position_date desc) as rn\n  from position_snapshots ps\n  join portfolios p on ps.portfolio_id = p.id\n  join legal_entities le on p.legal_entity_id = le.id\n)\nselect\n  date_trunc('month', position_date) as month,\n  entity,\n  sum(market_value) as total_market_value\nfrom latest\nwhere rn = 1\ngroup by 1, 2",
                "depends_on": [
