              "changes": [
                {
                  "op": "add",
                  "path": "process/steps/Collect the exports",
                  "before": "",
                  "after": "name: Collect the exports; who: Mei Chen; does: Downloads the administrator positions export and the trading system positions export (CSV) from portals and saves them to the shared file drop. Counts rows and compares control totals.; system: File drop"
                },
                {
                  "op": "add",
                  "path": "process/steps/Check cash against the administrator",
                  "before": "",
                  "after": "name: Check cash against the administrator; who: Mei Chen; does: Opens the cash tab of the reconciliation workbook and pastes administrator cash balances beside trading export balances. Highlights differences over tolerance and opens a break case.; system: Excel"
                },
                {
                  "op": "add",
                  "path": "process/steps/Collect manager statements",
                  "before": "",
                  "after": "name: Collect manager statements; who: Mei Chen; does: Saves PDF statements to the manager folder, types fund, period end, value, and received date into the statements tracker. Checks against the expected list and follows up on late/missing statements.; system: Email"
                },
                {
                  "op": "add",
                  "path": "process/steps/Convert to SGD",
                  "before": "",
                  "after": "name: Convert to SGD; who: Raj Patel; does: Takes holdings values from the tracker and cash from the recon workbook and converts them to SGD using the WMR 4pm USD/SGD fixing. The conversion is typed in.; system: Excel"
                },
                {
                  "op": "add",
                  "path": "process/steps/Review and approve the report",
                  "before": "",
                  "after": "name: Review and approve the report; who: Raj Patel; does: Assembles the report pack from converted figures and sends it for review. Estimates may be used. If a revision is over materiality, the review is reopened.; system: Report pack"
                },
