            ],
            "sql": "create or replace table gold_investment_report_holdings_monthly as\nwith holding as (\n  select v.valuation_date as as_of, p.legal_entity_id, i.canonical_name as holding, v.value_amount as net_worth_usd, v.approval_status as status\n  from valuation_observations v\n  join portfolios p on p.id = v.portfolio_id\n  join instruments i on i.id = v.instrument_id\n  where not exists (select 1 from valuation_observations x where x.supersedes_valuation_id = v.id)\n  union all\n  select s.position_date, p.legal_entity_id, i.canonical_name, s.source_market_value, s.data_status\n  from position_snapshots s\n  join portfolios p on p.id = s.portfolio_id\n  join instruments i on i.id = s.instrument_id\n  where i.instrument_type <> 'cash' and s.view_type = 'investment'\n    and not exists (select 1 from position_snapshots x where x.supersedes_position_id = s.id)\n)\nselect\n  date_trunc('month', h.as_of)::date as report_month,\n  e.entity_name as entity,\n  h.holding,\n  h.net_worth_usd,\n  h.net_worth_usd * (\n    select o.value from market_observations o\n    where o.series_key = 'FX:USDSGD:WMR_4PM' and o.observed_at <= h.as_of + interval 1 day\n    order by o.observed_at desc limit 1\n  ) as net_worth_sgd,\n  h.status\nfrom holding h\njoin legal_entities e on e.id = h.legal_entity_id",
            "depends_on": [
