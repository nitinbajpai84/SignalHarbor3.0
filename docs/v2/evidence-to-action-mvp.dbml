Project investment_evidence_to_action {
  database_type: 'PostgreSQL'
  Note: '''
  Logical MVP model for an investment-office evidence-to-action product.

  Principles:
  - Source records and documents are retained, not overwritten.
  - Investment estimates and official accounting NAV are separate.
  - Financial calculations run in deterministic, versioned code.
  - Agent findings and financial approvals are separate concepts.
  - Every data-bearing table includes organization_id for tenant scoping.

  Added in the merged version (9 Oct 2026):
  - Three times on every fact: effective (true in the world), received (office learnt it),
    recorded (we stored it). "As known at T" filters on recorded_at <= T.
  - Every observation table can point to the row it supersedes.
  - Extracted document fields, spreadsheet mappings and control totals, signed business rules,
    issued report versions and their exception impacts, access scopes for structured data,
    vector and full-text search columns, and the agent run behind each proposal.

  Enforce in implementation:
  - PostgreSQL row-level security on organization_id and on access_group_scopes.
  - Composite (organization_id, id) foreign keys, or RLS, so no row points into another organization.
  - CHECK constraints noted on metric_evidence, approvals and instrument_identifiers.
  '''
}

/* ============================================================
   1. ORGANIZATION, USERS, PERMISSIONS
   ============================================================ */

Table organizations {
  id uuid [pk]
  name varchar(200) [not null]
  created_at timestamptz [not null]
}

Table users {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  external_identity_id varchar(255) [not null]
  display_name varchar(200) [not null]
  email varchar(255) [not null]
  business_role varchar(100)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]

  indexes {
    (organization_id, external_identity_id) [unique]
    (organization_id, email)
  }
}

Table access_groups {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  group_name varchar(150) [not null]
  description text

  indexes {
    (organization_id, group_name) [unique]
  }
}

Table access_group_memberships {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  access_group_id uuid [not null, ref: > access_groups.id]
  user_id uuid [not null, ref: > users.id]
  granted_at timestamptz [not null]
  granted_by uuid [ref: > users.id]
  expires_at timestamptz

  indexes {
    (access_group_id, user_id) [unique]
  }
}

/*
  ADDED. Access to structured data, not only documents.
  Row-level security on positions, valuations, NAV, cash, metric values and exceptions
  joins through these scopes.
*/
Table access_group_scopes {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  access_group_id uuid [not null, ref: > access_groups.id]
  scope_type varchar(40) [not null, note: 'legal_entity, portfolio, document_type']
  scope_value varchar(255) [not null, note: 'legal_entity id, portfolio id or document type']
  access_level varchar(20) [not null, note: 'full, read, preview']

  indexes {
    (access_group_id, scope_type, scope_value) [unique]
  }
}

/* ============================================================
   2. INVESTMENT MASTER DATA
   ============================================================ */

Table legal_entities {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  entity_code varchar(80) [not null]
  entity_name varchar(200) [not null]
  base_currency char(3) [not null]
  active_from date
  active_to date

  indexes {
    (organization_id, entity_code) [unique]
  }
}

Table portfolios {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  legal_entity_id uuid [not null, ref: > legal_entities.id]
  portfolio_code varchar(80) [not null]
  portfolio_name varchar(200) [not null]
  base_currency char(3) [not null]
  active_from date
  active_to date

  indexes {
    (organization_id, portfolio_code) [unique]
  }
}

Table instruments {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  canonical_name varchar(255) [not null]
  instrument_type varchar(80) [not null, note: 'Examples: listed_equity, fund, bond, option, swap']
  asset_class varchar(80)
  manager_name varchar(200)
  currency char(3)
  created_at timestamptz [not null]

  indexes {
    (organization_id, canonical_name)
  }
}

/*
  Maps LGH IDs, administrator IDs, manager fund names,
  ISINs, Bloomberg identifiers, etc. to one canonical instrument.
  CHECK / partial unique index: at most one APPROVED mapping per
  (organization, source system, type, value) at any date.
*/
Table instrument_identifiers {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  instrument_id uuid [not null, ref: > instruments.id]
  source_system_id uuid [not null, ref: > source_systems.id]
  identifier_type varchar(80) [not null]
  identifier_value varchar(255) [not null]
  valid_from date
  valid_to date
  mapping_status varchar(40) [not null, note: 'proposed, approved, rejected']
  proposed_by_agent_run_id uuid [ref: > agent_runs.id, note: 'ADDED: which agent proposed the alias']
  approved_by uuid [ref: > users.id]
  approved_at timestamptz

  indexes {
    (organization_id, source_system_id, identifier_type, identifier_value, valid_from) [unique]
    (instrument_id, source_system_id)
  }
}

/* ============================================================
   3. SOURCE SYSTEMS AND IMMUTABLE INTAKE
   ============================================================ */

Table source_systems {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_code varchar(80) [not null]
  source_name varchar(200) [not null]
  source_type varchar(80) [not null, note: 'OMS, administrator, manager, market_data, internal, spreadsheet']
  connection_method varchar(80)
  owner_user_id uuid [ref: > users.id]
  licence_scope varchar(255)
  permitted_use varchar(255) [note: 'ADDED: e.g. display_only, may_index, may_send_to_model']
  expected_cadence varchar(80)
  is_active boolean [not null, default: true]

  indexes {
    (organization_id, source_code) [unique]
  }
}

/*
  ADDED. How a spreadsheet layout maps onto the canonical tables.
  Proposed by the data agent, approved once by the owner, reused every period.
  A layout change creates a new version; old batches keep the version they used.
*/
Table sheet_mappings {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_system_id uuid [not null, ref: > source_systems.id]
  file_pattern varchar(255) [not null, note: 'e.g. Positions *.xlsx']
  sheet_name varchar(150)
  header_row int
  version_number int [not null]
  mapping_status varchar(40) [not null, note: 'proposed, approved, retired']
  proposed_by_agent_run_id uuid [ref: > agent_runs.id]
  approved_by uuid [ref: > users.id]
  approved_at timestamptz

  indexes {
    (source_system_id, file_pattern, sheet_name, version_number) [unique]
  }
}

Table sheet_mapping_columns {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  sheet_mapping_id uuid [not null, ref: > sheet_mappings.id]
  source_column varchar(150) [not null]
  target_table varchar(80) [not null, note: 'e.g. position_snapshots']
  target_field varchar(80) [not null]
  transform_rule varchar(255) [note: 'e.g. date dd/mm/yyyy, values in thousands']
  confidence varchar(10) [note: 'ADDED (v3 wave 2): high, medium or doubt: how sure the proposed mapping is']

  indexes {
    (sheet_mapping_id, source_column) [unique]
  }
}

Table source_batches {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_system_id uuid [not null, ref: > source_systems.id]
  sheet_mapping_id uuid [ref: > sheet_mappings.id, note: 'ADDED: mapping version used for a spreadsheet batch']
  batch_reference varchar(150) [not null]
  received_at timestamptz [not null]
  loaded_at timestamptz [note: 'ADDED']
  source_period_end date
  content_hash varchar(128)
  storage_uri text
  validation_status varchar(40) [not null, note: 'loaded, rejected_totals, quarantined']
  validation_summary text
  arrived_on_time boolean [note: 'ADDED (v3 wave 2): As the load log states it']
  manual_fix boolean [note: 'ADDED (v3 wave 2): True when a person had to correct the file before it loaded']

  indexes {
    (source_system_id, batch_reference) [unique]
    (organization_id, received_at)
  }
}

/*
  ADDED. A batch is accepted only when what we loaded adds up
  to the totals stated in the file itself.
*/
Table batch_control_totals {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_batch_id uuid [not null, ref: > source_batches.id]
  measure_name varchar(150) [not null, note: 'e.g. row count, total market value, total cash']
  expected_value numeric(28,8) [not null, note: 'Read from the source file']
  loaded_value numeric(28,8)
  tolerance numeric(28,8)
  passed boolean

  indexes {
    (source_batch_id, measure_name) [unique]
  }
}

/*
  Raw records stay immutable. A correction creates a new record
  and points to the record it supersedes.
*/
Table source_records {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_batch_id uuid [not null, ref: > source_batches.id]
  external_record_id varchar(255)
  record_type varchar(100) [not null]
  effective_at timestamptz
  received_at timestamptz [not null]
  recorded_at timestamptz [not null, note: 'ADDED: when we stored it; drives as-known-at queries']
  sheet_name varchar(150) [note: 'ADDED: locator for spreadsheet rows']
  row_number int [note: 'ADDED']
  cell_range varchar(50) [note: 'ADDED']
  raw_payload_uri text [not null]
  content_hash varchar(128) [not null]
  supersedes_record_id uuid [ref: > source_records.id]
  quality_status varchar(40) [not null]

  indexes {
    (source_batch_id, external_record_id)
    (organization_id, record_type, effective_at)
    (organization_id, received_at)
    (organization_id, recorded_at)
  }
}

/* ============================================================
   4. UNSTRUCTURED EVIDENCE / RAG
   ============================================================ */

Table documents {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_system_id uuid [not null, ref: > source_systems.id]
  source_record_id uuid [ref: > source_records.id]
  access_group_id uuid [not null, ref: > access_groups.id]
  instrument_id uuid [ref: > instruments.id]

  external_document_id varchar(255)
  document_type varchar(100) [not null]
  title varchar(300) [not null]
  original_filename varchar(300)
  original_uri text [not null]
  content_hash varchar(128) [not null]

  document_date date
  valuation_date date
  received_at timestamptz [not null]
  recorded_at timestamptz [not null, note: 'ADDED']

  document_status varchar(40) [not null, note: 'estimate, revised_estimate, final, policy, research']
  supersedes_document_id uuid [ref: > documents.id]
  processing_status varchar(40) [not null]
  contains_personal_data boolean [note: 'ADDED: from the local scan; such passages need approval before indexing']

  indexes {
    (organization_id, document_type, received_at)
    (instrument_id, valuation_date)
    (content_hash)
  }
}

/*
  Search passages, but always retain a pointer to the original
  page/table/section. The text is evidence, not an instruction.
*/
Table document_passages {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  document_id uuid [not null, ref: > documents.id]
  access_group_id uuid [not null, ref: > access_groups.id]
  passage_order int [not null]
  page_number int
  line_from int [note: 'ADDED']
  line_to int [note: 'ADDED']
  section_label varchar(200)
  table_reference varchar(100)
  passage_text text [not null]
  search_text tsvector [note: 'ADDED: keyword search']
  embedding vector(384) [note: 'ADDED: pgvector, meaning search; dimension follows the embedding model']
  extraction_confidence numeric(5,4)
  embedding_model_version varchar(100)
  indexed_at timestamptz

  indexes {
    (document_id, passage_order) [unique]
    (organization_id, indexed_at)
  }
}

/*
  ADDED. What the intake agent read from a document, where, and who confirmed it.
  Low-confidence or material values wait for a person before they become observations.
*/
Table extracted_fields {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  document_id uuid [not null, ref: > documents.id]
  document_passage_id uuid [ref: > document_passages.id]
  field_name varchar(100) [not null, note: 'e.g. nav, units, valuation_date, call_amount, due_date']
  value_text varchar(255)
  value_numeric numeric(28,10)
  currency char(3)
  page_number int
  line_number int
  confidence varchar(20) [not null, note: 'high, medium, low']
  extracted_by_agent_run_id uuid [ref: > agent_runs.id]
  review_status varchar(40) [not null, note: 'pending, confirmed, corrected, rejected']
  reviewed_by uuid [ref: > users.id]
  reviewed_at timestamptz
  corrected_value_text varchar(255)

  indexes {
    (document_id, field_name)
    (organization_id, review_status)
  }
}

/* ============================================================
   5. STRUCTURED OPERATIONAL AND FINANCIAL OBSERVATIONS
   ============================================================ */

Table transactions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  portfolio_id uuid [not null, ref: > portfolios.id]
  instrument_id uuid [not null, ref: > instruments.id]

  external_trade_id varchar(200)
  transaction_type varchar(80) [not null]
  trade_date date
  effective_date date [not null]
  settlement_date date
  quantity_delta numeric(28,10)
  cash_amount numeric(28,8)
  currency char(3) [not null]

  recorded_at timestamptz [not null]
  status varchar(40) [not null]
  supersedes_transaction_id uuid [ref: > transactions.id]
  counterparty_name varchar(200) [note: 'ADDED (v3 wave 2): The broker or counterparty of the trade, as the settlement report names it']
  status_reason varchar(300) [note: 'ADDED (v3 wave 2): Why a trade is failed or pending, as the settlement report states it']

  indexes {
    (portfolio_id, instrument_id, effective_date)
    (external_trade_id, recorded_at)
  }
}

Table position_snapshots {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  portfolio_id uuid [not null, ref: > portfolios.id]
  instrument_id uuid [not null, ref: > instruments.id]

  position_date date [not null]
  as_of_at timestamptz [not null]
  received_at timestamptz [not null]
  recorded_at timestamptz [not null, note: 'ADDED']

  quantity numeric(28,10)
  source_market_value numeric(28,8)
  currency char(3)
  view_type varchar(50) [not null, note: 'operational, investment, accounting']
  data_status varchar(50) [not null, note: 'indicative, estimated, official']
  supersedes_position_id uuid [ref: > position_snapshots.id, note: 'ADDED']

  indexes {
    (portfolio_id, instrument_id, position_date, received_at)
    (organization_id, recorded_at)
  }
}

/*
  A manager estimate is not the same thing as approved portfolio P&L.
  Preserve every valuation and its document/source provenance.
*/
Table valuation_observations {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  instrument_id uuid [not null, ref: > instruments.id]
  portfolio_id uuid [ref: > portfolios.id]
  source_record_id uuid [ref: > source_records.id]
  evidence_document_id uuid [ref: > documents.id]
  extracted_field_id uuid [ref: > extracted_fields.id, note: 'ADDED: the exact value read, with page and line']

  valuation_date date [not null]
  received_at timestamptz [not null]
  recorded_at timestamptz [not null, note: 'ADDED']
  value_amount numeric(28,8) [not null]
  currency char(3) [not null]

  valuation_type varchar(80) [not null, note: 'manager_estimate, manager_final, internal, administrator']
  approval_status varchar(40) [not null]
  supersedes_valuation_id uuid [ref: > valuation_observations.id]

  indexes {
    (instrument_id, portfolio_id, valuation_date, received_at)
    (organization_id, recorded_at)
  }
}

/*
  What an investor promised to put into a fund (private markets).
  Append-only: a change is a new row that supersedes the old one.
  Capital calls and distributions are cash_movements rows linked by commitment_id.
*/
Table commitments {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  legal_entity_id uuid [not null, ref: > legal_entities.id]
  instrument_id uuid [not null, ref: > instruments.id]
  source_record_id uuid [ref: > source_records.id]
  commitment_amount numeric(28,8) [not null]
  currency char(3) [not null]
  committed_on date [not null]
  called_to_date numeric(28,8) [note: 'Capital called to date as the commitments file states it, at called_as_at']
  called_as_at date [note: 'The as-at date of the file that stated called_to_date']
  recorded_at timestamptz [not null]
  supersedes_commitment_id uuid [ref: > commitments.id]

  indexes {
    (legal_entity_id, instrument_id, committed_on)
  }
}

Table cash_movements {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  portfolio_id uuid [not null, ref: > portfolios.id]
  instrument_id uuid [ref: > instruments.id]

  movement_type varchar(80) [not null, note: 'subscription, redemption, call, distribution, dividend, coupon, fee, payment, transfer, allowance']
  effective_date date [not null]
  received_at timestamptz [not null]
  recorded_at timestamptz [not null, note: 'ADDED']
  amount numeric(28,8) [not null]
  currency char(3) [not null]
  confirmation_status varchar(40) [not null, note: 'expected, noticed, confirmed, cancelled']
  supersedes_cash_movement_id uuid [ref: > cash_movements.id, note: 'ADDED']
  due_date date [note: 'ADDED: when a call must be paid or a distribution is expected']
  notice_kind varchar(40) [note: 'ADDED: call, distribution, recallable, dividend, coupon']
  commitment_id uuid [ref: > commitments.id, note: 'ADDED']
  bank_account_id uuid [ref: > bank_accounts.id, note: 'ADDED (v3): the account the money goes to (a payee account for a payment) or comes from']
  counterparty_portfolio_id uuid [ref: > portfolios.id, note: 'ADDED (v3): the other side of a transfer between two portfolios of the office; each side is one row naming the other']
  payment_stage varchar(20) [note: 'ADDED (v3 wave 2): expected, approved, scheduled, held, released: where a payment stands in the schedule; the approvals that moved it are approvals rows']
  payee_name varchar(200) [note: 'ADDED (v3 wave 2): Who a payment is to, when no bank_account_id is on file']
  reference varchar(100) [note: 'ADDED (v3 wave 2): The schedule, ledger or bank reference of the movement; joins to office_expenses and grants']

  indexes {
    (portfolio_id, instrument_id, effective_date)
  }
}

/*
  An FX forward confirmation from a counterparty (v3, assumption A1): one row per confirmation, both legs on the row, so it can be
  matched against the trading desk's trade (transactions) by trade reference. Amounts are positive; the legs are named, not signed.
*/
Table fx_confirmations {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]

  trade_reference varchar(200) [not null, note: 'The reference the trading desk uses for the trade']
  trade_date date [not null]
  value_date date
  currency_bought char(3)
  amount_bought numeric(28,8)
  currency_sold char(3)
  amount_sold numeric(28,8)
  rate numeric(28,10)
  counterparty varchar(200)
  source_document_id varchar(100) [note: 'The confirmation document in Evidence']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_fx_confirmation_id uuid [ref: > fx_confirmations.id]

  indexes {
    (trade_reference, recorded_at)
  }
}

/*
  Which statement the office expects from each fund each period (v3, assumption A2). Filled from the fund's stated frequency,
  else from the cadence of statements already received, else from a schedule a person confirms. due_date is null when no terms are on file.
*/
Table expected_statements {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  instrument_id uuid [not null, ref: > instruments.id]
  source_record_id uuid [ref: > source_records.id]

  period_end date [not null]
  due_date date [note: 'period_end plus the days the fund terms state; null when no terms are on file']
  frequency varchar(20) [not null, note: 'monthly, quarterly, semi_annual, annual']
  source varchar(200) [not null, note: 'how it was decided: fund terms, cadence of received statements, confirmed by a person']
  due_reason varchar(200) [note: 'why due_date is empty']
  recorded_at timestamptz [not null]
  supersedes_expected_statement_id uuid [ref: > expected_statements.id]

  indexes {
    (instrument_id, period_end, recorded_at)
  }
}

/* ============================================================
   OFFICE RECORDS (v3, assumptions A11 to A19). Source facts the office receives or records and that no other table can hold.
   Each row is one observation; a change is a new row that supersedes the old one. Derived things (balances by bank, mandate fit,
   renewals due, net worth after debt) are figures, never tables.
   ============================================================ */

/*
  An account the office holds (holder_kind office: operating, custody, brokerage) or an account on file for someone we pay (payee: a fund,
  a vendor, a person). Replaces the proposed counterparties and standing_instructions. Only the masked reference is kept, never the full number.
  A changed payee account is a new row that supersedes the old one; the verified_* columns record the call-back.
*/
Table bank_accounts {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_bank_account_id uuid [ref: > bank_accounts.id]

  holder_kind varchar(20) [not null, note: 'office or payee']
  legal_entity_id uuid [ref: > legal_entities.id, note: 'The office entity that holds the account (holder_kind office)']
  instrument_id uuid [ref: > instruments.id, note: 'The fund the account pays into (holder_kind payee)']
  holder_name varchar(200) [note: 'Who the account belongs to when it is neither an entity nor a fund: a vendor, a person']
  account_purpose varchar(40) [not null, note: 'operating, custody, brokerage, loan, payee']
  bank_name varchar(200) [not null]
  account_ref varchar(80) [not null, note: 'Masked: the last four characters, or the IBAN tail']
  currency char(3)
  cash_instrument_id uuid [ref: > instruments.id, note: 'The cash instrument whose position snapshots are this account balance']
  status varchar(20) [not null, note: 'active, closed, pending']
  opened_on date
  closed_on date
  verified_on date [note: 'When a person last called the bank or payee back on a known number']
  verified_by uuid [ref: > users.id]

  indexes {
    (organization_id, bank_name, account_ref, recorded_at)
    (instrument_id, recorded_at)
  }
}

/*
  A loan or credit facility the office owes on, as a statement or agreement states it at a date. The balance owed at a date is the
  drawn amount of the latest row at or before that date; net worth after debt is a figure.
*/
Table credit_facilities {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_credit_facility_id uuid [ref: > credit_facilities.id]

  facility_ref varchar(100) [not null, note: 'The lender reference; the same on every observation of one facility']
  legal_entity_id uuid [not null, ref: > legal_entities.id, note: 'The borrower']
  lender varchar(200) [not null]
  facility_type varchar(40) [not null, note: 'loan, credit_line, mortgage, margin']
  currency char(3) [not null]
  limit_amount numeric(28,8)
  drawn_amount numeric(28,8) [not null, note: 'Owed at as_at, a positive number']
  interest_rate numeric(12,6) [note: 'Annual, as a fraction']
  rate_basis varchar(80) [note: 'fixed, or the reference rate plus the spread']
  maturity_date date
  collateral varchar(300)
  as_at date [not null]
  status varchar(20) [not null, note: 'active, repaid, defaulted']

  indexes {
    (organization_id, facility_ref, as_at, recorded_at)
  }
}

/*
  A person of the family the office pays or reports to. The allowance is the amount the family agreed to pay them, from the
  schedule the office holds; what was paid is in cash_movements. Personal data: access is scoped by entity.
*/
Table family_members {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_family_member_id uuid [ref: > family_members.id]

  member_name varchar(200) [not null]
  relationship varchar(80) [note: 'principal, spouse, child, grandchild, parent, other']
  legal_entity_id uuid [ref: > legal_entities.id, note: 'The entity or trust that holds or pays for them']
  user_id uuid [ref: > users.id, note: 'Set when the person signs in']
  allowance_amount numeric(28,8)
  allowance_currency char(3)
  allowance_frequency varchar(20) [note: 'monthly, quarterly, annual']
  allowance_from date
  allowance_to date
  paid_from_portfolio_id uuid [ref: > portfolios.id]
  active_from date
  active_to date

  indexes {
    (organization_id, member_name, recorded_at)
  }
}

/* A contract with a vendor or adviser (administrator, auditor, lawyer, software, insurer). Renewals due and annual cost are figures. */
Table vendor_contracts {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_vendor_contract_id uuid [ref: > vendor_contracts.id]

  vendor_name varchar(200) [not null]
  service varchar(200)
  contract_ref varchar(100)
  legal_entity_id uuid [ref: > legal_entities.id, note: 'The office entity that signed']
  owner_user_id uuid [ref: > users.id, note: 'The person in the office who manages the vendor']
  start_date date
  end_date date
  next_renewal_date date
  auto_renews boolean
  notice_days integer [note: 'Days before the renewal date by which notice must be given']
  annual_cost numeric(28,8)
  currency char(3)
  status varchar(20) [not null, note: 'active, ended, under_review']
  contract_kind varchar(20) [note: 'ADDED (v3 wave 2): service, insurance, lease, other. Empty means service']
  sum_insured numeric(28,8) [note: 'ADDED (v3 wave 2): For an insurance policy: the cover, in its currency']
  covered_asset_ref varchar(60) [note: 'ADDED (v3 wave 2): For an insurance policy: the real_assets.asset_ref it covers, empty for liability or cyber']

  indexes {
    (organization_id, vendor_name, recorded_at)
    (organization_id, next_renewal_date)
  }
}

/*
  A new fund or deal the office is looking at, one row for each stage it has reached. Mandate fit and headroom are figures.
  instrument_id is set when the deal becomes a holding.
*/
Table deal_pipeline {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_deal_id uuid [ref: > deal_pipeline.id]

  deal_name varchar(250) [not null]
  manager_name varchar(200)
  strategy varchar(200)
  asset_class varchar(80)
  instrument_id uuid [ref: > instruments.id]
  target_commitment numeric(28,8)
  currency char(3)
  stage varchar(40) [not null, note: 'screening, diligence, committee, approved, declined, closed']
  stage_on date [not null]
  owner_user_id uuid [ref: > users.id]

  indexes {
    (organization_id, deal_name, recorded_at)
  }
}

/*
  What the committee decided, from its minutes. subject_id points at the deal_pipeline, exceptions or rule_versions row it decided on.
  An individual sign-off stays in approvals; this is the committee record.
*/
Table committee_decisions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_committee_decision_id uuid [ref: > committee_decisions.id]

  committee varchar(100) [not null, note: 'For example Investment committee']
  decided_on date [not null]
  title varchar(250) [not null]
  subject_type varchar(40) [note: 'deal, exception, policy, commitment, other']
  subject_id varchar(100)
  outcome varchar(40) [not null, note: 'approved, declined, deferred, waiver, cured']
  conditions text
  amount numeric(28,8)
  currency char(3)
  recorded_by uuid [ref: > users.id]

  indexes {
    (organization_id, committee, decided_on)
  }
}

/*
  One line of the office's own expense ledger: money the office spent, with its category and the person who approved it. It is not a cash movement: the bank line of the same payment is already in cash_movements, and a second row there would count the cash twice. Budget is a signed rule (office_budget_<category>); actual against budget and approver-limit breaches are figures. A USD equivalent is a figure at the day's fixing, never stored.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table office_expenses {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_office_expense_id uuid [ref: > office_expenses.id]

  spent_on date [not null]
  category varchar(80) [not null, note: 'As the ledger names it: Staff, Premises, Professional fees, Grants']
  payee_name varchar(200)
  legal_entity_id uuid [ref: > legal_entities.id, note: 'The entity that paid']
  currency char(3) [not null]
  amount numeric(28,8) [not null, note: 'In its own currency, positive']
  reference varchar(100) [note: 'The ledger reference; joins to cash_movements.reference when the bank line is loaded']
  approver_name varchar(200)
  approver_user_id uuid [ref: > users.id]

  indexes {
    (organization_id, spent_on)
    (organization_id, reference)
  }
}

/*
  An event on a security that the custodian notifies: a dividend, a coupon, a tender offer. The expected cash of a dividend or coupon is also a cash_movements row (expected, then noticed or confirmed); this row holds the dates and the choice the office must make. What is due in 14 days and a dividend forecast are figures.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table corporate_actions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_corporate_action_id uuid [ref: > corporate_actions.id]

  instrument_id uuid [not null, ref: > instruments.id]
  action_type varchar(40) [not null, note: 'dividend, coupon, tender_offer, split, merger, rights']
  custodian_ref varchar(100) [note: 'The custodian notice reference']
  announced_on date
  ex_date date
  record_date date
  pay_date date
  rate_per_unit numeric(28,10) [note: 'Per share for a dividend, per unit of face for a coupon']
  currency char(3)
  election_required boolean [note: 'True when the holder must choose before the deadline (a voluntary action)']
  election_deadline date
  elected_option varchar(80) [note: 'What the office chose, once it has']
  status varchar(20) [not null, note: 'announced, elected, paid, lapsed']

  indexes {
    (instrument_id, pay_date)
    (organization_id, custodian_ref, recorded_at)
  }
}

/*
  A property, land, art, wine or vessel the family owns, as one appraisal or title observation of it. The same asset_ref repeats on each new appraisal; the latest row at or before a date is its value then. Held outside positions on purpose: a position row would change the net worth figures. Age of appraisal, cover gap and estate value are figures.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table real_assets {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_real_asset_id uuid [ref: > real_assets.id]

  asset_ref varchar(60) [not null, note: 'The same on every observation of one asset']
  asset_name varchar(200) [not null]
  asset_type varchar(40) [not null, note: 'residential_property, land, art, wine, vessel, other']
  legal_entity_id uuid [ref: > legal_entities.id, note: 'The entity the office treats as the owner']
  title_holder_name varchar(200) [note: 'Who the title deed names; it can differ from the entity']
  currency char(3) [not null]
  appraised_value numeric(28,8)
  appraised_on date
  appraiser varchar(200)
  status varchar(20) [not null, note: 'held, sold']

  indexes {
    (organization_id, asset_ref, recorded_at)
  }
}

/*
  A purchase lot of a listed holding, from the custodian's lot register: the quantity and cost on a date. Unrealised gain by lot is a figure (market value less cost). A sale is a transaction; the lot is reduced by a new row that supersedes the old.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table tax_lots {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_tax_lot_id uuid [ref: > tax_lots.id]

  portfolio_id uuid [not null, ref: > portfolios.id]
  instrument_id uuid [not null, ref: > instruments.id]
  lot_ref varchar(100) [not null]
  acquired_on date [not null]
  quantity numeric(28,10) [not null]
  unit_cost numeric(28,10)
  cost_amount numeric(28,8) [not null]
  currency char(3) [not null]
  as_at date [not null, note: 'The date the register states the lot at']
  status varchar(20) [not null, note: 'open, closed']

  indexes {
    (portfolio_id, instrument_id, lot_ref, recorded_at)
  }
}

/*
  A filing or payment the office owes a tax authority, from the tax adviser's calendar. A new status is a new row that supersedes the old. Overdue and days to due are figures. Tax rates are signed rules (tax_rate_<entity>), not columns.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table tax_obligations {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_tax_obligation_id uuid [ref: > tax_obligations.id]

  obligation_ref varchar(60) [not null]
  legal_entity_id uuid [not null, ref: > legal_entities.id]
  obligation varchar(300) [not null]
  due_date date [not null]
  prepared_by varchar(200) [note: 'The adviser or person preparing it']
  estimated_amount numeric(28,8)
  currency char(3)
  status varchar(40) [not null, note: 'As the calendar states it: not started, draft with adviser, filed, paid']
  filed_on date
  paid_on date

  indexes {
    (organization_id, obligation_ref, recorded_at)
    (organization_id, due_date)
  }
}

/*
  A charitable grant the office is asked for, has pledged or has paid, from the grant requests and the grant ledger. The annual budget is a signed rule (grant_budget). The payment is a bank line in cash_movements that carries the same reference. Used and remaining budget are figures.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table grants {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_grant_id uuid [ref: > grants.id]

  grant_ref varchar(60) [not null]
  charity_name varchar(200) [not null]
  charity_registered_on date [note: 'When the charity was registered; its age is a figure']
  purpose varchar(300)
  legal_entity_id uuid [ref: > legal_entities.id, note: 'The entity that pays']
  amount numeric(28,8) [not null]
  currency char(3) [not null]
  requested_on date
  decided_on date
  paid_on date
  payment_reference varchar(100) [note: 'Joins to cash_movements.reference']
  status varchar(20) [not null, note: 'requested, pledged, paid, declined']

  indexes {
    (organization_id, grant_ref, recorded_at)
  }
}

/*
  One employee or contractor on one pay run, as the payroll register states it. Sensitive personal pay data: the source document must sit in a restricted access group. Draft against last month, total cost and raises are figures. Employer cost is gross plus employer_contribution.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table staff_payroll {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_staff_payroll_id uuid [ref: > staff_payroll.id]

  pay_period date [not null, note: 'First day of the pay month']
  employee_name varchar(200) [not null]
  title varchar(200)
  employment_kind varchar(20) [not null, note: 'employee, contractor']
  legal_entity_id uuid [ref: > legal_entities.id, note: 'The entity that pays']
  currency char(3) [not null]
  gross_pay numeric(28,8) [not null]
  employee_contribution numeric(28,8) [note: 'Statutory deduction from the employee, as the register states it']
  employer_contribution numeric(28,8) [note: 'Statutory cost on top of gross, as the register states it']
  net_pay numeric(28,8)
  pay_date date
  run_status varchar(20) [not null, note: 'draft, approved, paid']

  indexes {
    (organization_id, pay_period, employee_name, recorded_at)
  }
}

/*
  One identity or due-diligence document held for an entity or a person, with its dates. Personal identity data: the document number is never stored here, only that the document exists and when it expires; the source document must sit in a restricted access group. Expiring and expired are figures.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table kyc_records {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_kyc_record_id uuid [ref: > kyc_records.id]

  subject_kind varchar(20) [not null, note: 'legal_entity, person, manager']
  subject_name varchar(200) [not null]
  legal_entity_id uuid [ref: > legal_entities.id, note: 'Set when the subject is one of the office entities']
  document_kind varchar(80) [not null, note: 'passport, proof_of_address, incorporation, ownership_declaration, other']
  issued_on date
  expires_on date
  verified_on date
  verified_by uuid [ref: > users.id]
  status varchar(20) [not null, note: 'valid, pending, rejected']

  indexes {
    (organization_id, subject_name, document_kind, recorded_at)
    (organization_id, expires_on)
  }
}

/*
  What a fund owns, as its manager reports it: a company and its weight in the fund at a date. The companies are not instruments of the office. Look-through exposure of the family is a figure (weight times the office's value of the fund).
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table fund_holdings {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_fund_holding_id uuid [ref: > fund_holdings.id]

  instrument_id uuid [not null, ref: > instruments.id, note: 'The fund']
  holding_name varchar(200) [not null]
  sector varchar(100)
  weight_pct numeric(12,6) [not null, note: 'Percent of the fund, as reported (12 means 12 percent)']
  as_at date [not null]

  indexes {
    (instrument_id, as_at)
  }
}

/*
  A person's access to one of the office's systems (order system, bank portal, shared drive, Harbor), from the access register. Not Harbor's own data access (access_group_memberships and access_group_scopes). A joiner, a mover or a leaver is a new row that supersedes the old; unused and without-approver are figures.
  Added by the v3 steward for cards 51 to 100 (assumptions A32 onward). Same organisation and load columns as fx_confirmations.
*/
Table system_access_grants {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_system_access_grant_id uuid [ref: > system_access_grants.id]

  person_name varchar(200) [not null]
  user_id uuid [ref: > users.id, note: 'Set while the person is a Harbor user; a leaver has none']
  system_name varchar(100) [not null]
  access_level varchar(40)
  granted_on date
  approved_by_name varchar(200) [note: 'Empty means no approver is recorded']
  approved_by_user_id uuid [ref: > users.id]
  last_used_on date
  revoked_on date
  status varchar(20) [not null, note: 'active, revoked']

  indexes {
    (organization_id, person_name, system_name, recorded_at)
  }
}

/*
  Who owns what share of an entity, as at a date: a legal entity or a family member owns a percentage of another legal entity, from a date to a date. It comes from a share register or a trust deed schedule. Look-through exposure (a person's or entity's share of a position, commitment or cash, however many holdings deep) is a figure, never stored.
  Added by the v3 steward for the ownership look-through (assumption A61). Same organisation and load columns as fx_confirmations.
*/
Table entity_ownership {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  source_document_id varchar(100) [note: 'The document in Evidence the values were read from: the share register or the trust deed']
  source_page integer [note: 'The page the values were read from']
  received_at timestamptz [not null]
  recorded_at timestamptz [not null]
  supersedes_entity_ownership_id uuid [ref: > entity_ownership.id]

  owner_kind varchar(20) [not null, note: 'entity or family_member']
  owner_entity_id uuid [ref: > legal_entities.id, note: 'Set when owner_kind is entity']
  owner_family_member_id uuid [ref: > family_members.id, note: 'Set when owner_kind is family_member']
  owned_entity_id uuid [not null, ref: > legal_entities.id]
  ownership_pct numeric(9,6) [not null, note: 'A percent, 0 to 100']
  valid_from date [not null]
  valid_to date [note: 'Empty means still in force']

  indexes {
    (organization_id, owned_entity_id, valid_from)
  }
}

/*
  Covers licensed prices, index levels, rates and FX observations.
  series_key is the provider's identifier; mapping/entitlement
  must be checked before use in a report.
*/
Table market_observations {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source_record_id uuid [not null, ref: > source_records.id]
  instrument_id uuid [ref: > instruments.id]

  series_key varchar(150) [not null]
  observation_type varchar(50) [not null, note: 'price, index_level, rate, fx']
  observed_at timestamptz [not null]
  received_at timestamptz [not null]
  recorded_at timestamptz [not null, note: 'ADDED']

  value numeric(28,10) [not null]
  base_currency char(3)
  quote_currency char(3)
  quality_status varchar(40) [not null]
  supersedes_observation_id uuid [ref: > market_observations.id, note: 'ADDED']

  indexes {
    (series_key, observed_at, received_at)
  }
}

/*
  The administrator's official view is separately modelled from
  a fund manager valuation or an investment-team estimate.
*/
Table nav_snapshots {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  portfolio_id uuid [not null, ref: > portfolios.id]
  source_record_id uuid [not null, ref: > source_records.id]

  nav_period_end date [not null]
  received_at timestamptz [not null]
  recorded_at timestamptz [not null, note: 'ADDED']
  nav_amount numeric(28,8) [not null]
  currency char(3) [not null]

  nav_status varchar(50) [not null, note: 'draft, approved_official, restated']
  approved_at timestamptz
  supersedes_nav_id uuid [ref: > nav_snapshots.id]

  indexes {
    (portfolio_id, nav_period_end, received_at)
  }
}

/* ============================================================
   6. BUSINESS RULES AND VERSIONED BENCHMARK DEFINITIONS
   ============================================================ */

/*
  ADDED. Tolerances, materiality, estimate use, FX fixing, due dates.
  Only a signed version takes effect; outputs record the version they used.
*/
Table business_rules {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  rule_code varchar(100) [not null, note: 'e.g. cash_tolerance, cio_materiality, estimate_use, fx_fixing, statement_due']
  rule_type varchar(50) [not null, note: 'tolerance, materiality, policy, fixing, deadline']
  owner_user_id uuid [not null, ref: > users.id]

  indexes {
    (organization_id, rule_code) [unique]
  }
}

Table rule_versions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  business_rule_id uuid [not null, ref: > business_rules.id]
  version_number int [not null]
  definition_text text [not null, note: 'Plain words']
  parameters jsonb [note: 'Machine form, e.g. {"abs_amount": 5000, "currency": "USD"}']
  effective_from date [not null]
  effective_to date
  approval_status varchar(40) [not null, note: 'draft, approved, retired']
  approved_by uuid [ref: > users.id]
  approved_at timestamptz

  indexes {
    (business_rule_id, version_number) [unique]
  }
}

Table benchmark_definitions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]

  benchmark_code varchar(100) [not null]
  benchmark_name varchar(200) [not null]
  version_number int [not null]

  reporting_currency char(3) [not null]
  effective_from date [not null]
  effective_to date
  calculation_method text [not null]

  approval_status varchar(40) [not null, note: 'draft, in_progress, approved; in_progress is never certified']
  approved_by uuid [ref: > users.id]

  indexes {
    (organization_id, benchmark_code, version_number) [unique]
  }
}

Table benchmark_components {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  benchmark_definition_id uuid [not null, ref: > benchmark_definitions.id]

  market_series_key varchar(150) [not null]
  component_weight numeric(18,10) [not null]
  spread_bps numeric(12,4) [note: 'ADDED: premium over the index, e.g. index plus 300 bps']
  weight_effective_from date [not null]
  weight_effective_to date
  treatment_note text

  indexes {
    (benchmark_definition_id, market_series_key, weight_effective_from)
  }
}

/* ============================================================
   7. INTENTS, CALCULATIONS, AND TRACEABLE OUTPUTS
   ============================================================ */

Table decision_intents {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  requested_by uuid [not null, ref: > users.id]
  business_owner_id uuid [ref: > users.id]

  title varchar(250) [not null]
  business_question text [not null]
  intended_audience varchar(255)
  permitted_use varchar(100) [not null]
  value_basis varchar(40) [note: 'ADDED: investment_estimate or official']
  output_description text
  acceptance_tests text [note: 'ADDED: e.g. rebuild July and August within 1 USD']
  open_choices text [note: 'ADDED']

  status varchar(50) [not null, note: 'draft, pending_approval, approved, retired']
  contract_version int [not null, default: 1]
  approved_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (organization_id, status, created_at)
  }
}

Table metric_definitions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  decision_intent_id uuid [ref: > decision_intents.id]

  metric_code varchar(120) [not null]
  metric_name varchar(200) [not null]
  version_number int [not null]
  definition_text text [not null]

  implementation_ref varchar(255) [not null, note: 'Versioned SQL/dbt/Python reference, not free-form model output']
  owner_user_id uuid [not null, ref: > users.id]
  approval_status varchar(40) [not null]

  indexes {
    (organization_id, metric_code, version_number) [unique]
  }
}

Table calculation_runs {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  decision_intent_id uuid [ref: > decision_intents.id]

  started_at timestamptz [not null]
  finished_at timestamptz
  knowledge_cutoff_at timestamptz [not null, note: 'Only facts with recorded_at <= this are used']
  reporting_date date [not null]

  code_version varchar(120) [not null]
  rule_versions_used jsonb [note: 'ADDED: rule_version ids applied in this run']
  input_manifest_uri text [not null]
  run_status varchar(50) [not null]
  validation_status varchar(50) [not null]

  indexes {
    (organization_id, reporting_date, knowledge_cutoff_at)
  }
}

Table metric_values {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  calculation_run_id uuid [not null, ref: > calculation_runs.id]
  metric_definition_id uuid [not null, ref: > metric_definitions.id]

  portfolio_id uuid [ref: > portfolios.id]
  instrument_id uuid [ref: > instruments.id]

  reporting_date date [not null]
  numeric_value numeric(28,10)
  currency char(3)
  value_status varchar(50) [not null, note: 'draft, indicative, certified']
  published_at timestamptz

  indexes {
    (portfolio_id, reporting_date, metric_definition_id)
    (calculation_run_id, metric_definition_id)
  }
}

/*
  Exactly one evidence pointer should be populated per row:
  source_record_id OR document_passage_id OR extracted_field_id.
  Enforce with a PostgreSQL CHECK constraint during implementation.
*/
Table metric_evidence {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  metric_value_id uuid [not null, ref: > metric_values.id]
  source_record_id uuid [ref: > source_records.id]
  document_passage_id uuid [ref: > document_passages.id]
  extracted_field_id uuid [ref: > extracted_fields.id, note: 'ADDED']
  evidence_role varchar(80) [not null, note: 'input, adjustment, explanation, policy']
  note text

  indexes {
    (metric_value_id, evidence_role)
  }
}

/*
  ADDED. A report as it was issued: which run, which cut-off, who approved it.
  An issued version is never changed; a correction is a new version that supersedes it.
*/
Table reports {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  decision_intent_id uuid [ref: > decision_intents.id]
  report_code varchar(100) [not null]
  report_name varchar(200) [not null]
  audience varchar(150)
  reporting_currencies varchar(20) [note: 'e.g. USD,SGD']

  indexes {
    (organization_id, report_code) [unique]
  }
}

Table report_versions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  report_id uuid [not null, ref: > reports.id]
  calculation_run_id uuid [not null, ref: > calculation_runs.id]
  period_end date [not null]
  cutoff_at timestamptz [not null]
  status varchar(40) [not null, note: 'draft, ready_for_review, approved, issued, superseded']
  approved_by uuid [ref: > users.id]
  issued_at timestamptz
  supersedes_report_version_id uuid [ref: > report_versions.id]

  indexes {
    (report_id, period_end, issued_at)
  }
}

/* ============================================================
   8. EXCEPTIONS, APPROVALS, DAILY PULSE
   ============================================================ */

Table exceptions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  decision_intent_id uuid [ref: > decision_intents.id]
  calculation_run_id uuid [ref: > calculation_runs.id]
  portfolio_id uuid [ref: > portfolios.id]
  instrument_id uuid [ref: > instruments.id]

  exception_type varchar(100) [not null, note: 'revision, break, missing_document, stale_data, limit_breach, policy_question, capital_call']
  title varchar(250) [not null]
  description text
  detected_at timestamptz [not null]

  candidate_impact_amount numeric(28,8)
  impact_currency char(3)
  materiality_status varchar(50) [not null, note: 'unknown, below_threshold, material']
  materiality_rule_version_id uuid [ref: > rule_versions.id, note: 'ADDED: the signed rule that set materiality']
  status varchar(50) [not null, note: 'new, assigned, investigating, resolved, rejected']

  owner_user_id uuid [ref: > users.id]
  due_at timestamptz
  resolution_code varchar(100)
  resolved_at timestamptz
  external_ref varchar(100) [note: 'ADDED (v3 wave 2): The id the office register gives it (a break id)']
  legal_entity_id uuid [note: 'ADDED (v3 wave 2): The entity it concerns, when the register names an entity and not a portfolio']

  indexes {
    (organization_id, status, due_at)
    (portfolio_id, detected_at)
  }
}

/*
  ADDED. Which issued reports an exception touches, and the draft revised figure.
*/
Table exception_impacts {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  exception_id uuid [not null, ref: > exceptions.id]
  report_version_id uuid [not null, ref: > report_versions.id]
  metric_value_id uuid [ref: > metric_values.id]
  issued_value numeric(28,10)
  draft_value numeric(28,10)
  currency char(3)

  indexes {
    (exception_id, report_version_id)
  }
}

Table exception_events {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  exception_id uuid [not null, ref: > exceptions.id]
  performed_by_user_id uuid [ref: > users.id]
  agent_run_id uuid [ref: > agent_runs.id, note: 'ADDED: set when an agent proposed this step']

  event_type varchar(80) [not null, note: 'opened, assigned, explanation_proposed, explanation_confirmed, escalated, resolved, reopened']
  event_note text
  occurred_at timestamptz [not null]

  source_record_id uuid [ref: > source_records.id]
  evidence_document_id uuid [ref: > documents.id]

  indexes {
    (exception_id, occurred_at)
  }
}

/*
  For an MVP, exactly one of the target IDs should be populated.
  Enforce the exact-one-target rule with a database CHECK constraint.
  Maker-checker: decision_by_user_id must differ from the exception owner
  and from whoever prepared the item (enforce in the service and a trigger).
*/
Table approvals {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]

  decision_intent_id uuid [ref: > decision_intents.id]
  calculation_run_id uuid [ref: > calculation_runs.id]
  exception_id uuid [ref: > exceptions.id]
  report_version_id uuid [ref: > report_versions.id, note: 'ADDED']
  rule_version_id uuid [ref: > rule_versions.id, note: 'ADDED']
  sheet_mapping_id uuid [ref: > sheet_mappings.id, note: 'ADDED']
  cash_movement_id uuid [ref: > cash_movements.id, note: 'ADDED (v3): a payment or transfer that needs this approval']

  approval_type varchar(100) [not null]
  requested_from_user_id uuid [not null, ref: > users.id]
  decision_by_user_id uuid [ref: > users.id]

  status varchar(40) [not null, note: 'requested, approved, rejected, withdrawn']
  rationale text
  requested_at timestamptz [not null]
  decided_at timestamptz

  indexes {
    (organization_id, status, requested_from_user_id)
  }
}

Table pulse_items {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  recipient_user_id uuid [not null, ref: > users.id]
  exception_id uuid [ref: > exceptions.id]
  metric_value_id uuid [ref: > metric_values.id]

  headline varchar(250) [not null]
  summary text [not null]
  generated_at timestamptz [not null]
  as_of_at timestamptz [not null]

  urgency varchar(40) [not null]
  action_type varchar(80)
  delivery_status varchar(40) [not null]
  acknowledged_at timestamptz
  outcome varchar(40) [note: 'ADDED: acted, dismissed_with_reason, ignored; feeds the usefulness measure']

  indexes {
    (recipient_user_id, generated_at)
    (organization_id, urgency, delivery_status)
  }
}

/* ============================================================
   9. AGENT EXECUTION AND AUDITABILITY
   ============================================================ */

Table agent_runs {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  decision_intent_id uuid [ref: > decision_intents.id]
  exception_id uuid [ref: > exceptions.id]
  acting_for_user_id uuid [ref: > users.id, note: 'ADDED: agents act inside this person\'s permissions']

  agent_type varchar(100) [not null, note: 'intent, intake, data, investigation, briefing']
  model_id varchar(150) [not null]
  prompt_version varchar(100) [not null]
  tool_policy_version varchar(100) [not null]

  started_at timestamptz [not null]
  finished_at timestamptz
  run_status varchar(50) [not null]
  tool_calls int [note: 'ADDED: counted against the run limit']
  cost_usd numeric(12,6) [note: 'ADDED']

  trace_id varchar(150)
  output_artifact_uri text
  human_review_status varchar(50)

  indexes {
    (organization_id, agent_type, started_at)
    (trace_id)
  }
}

TableGroup access {
  organizations
  users
  access_groups
  access_group_memberships
  access_group_scopes
}

TableGroup master_data {
  legal_entities
  portfolios
  instruments
  instrument_identifiers
}

TableGroup intake {
  source_systems
  sheet_mappings
  sheet_mapping_columns
  source_batches
  batch_control_totals
  source_records
}

TableGroup documents_and_rag {
  documents
  document_passages
  extracted_fields
}

TableGroup observations {
  transactions
  position_snapshots
  valuation_observations
  commitments
  cash_movements
  fx_confirmations
  expected_statements
  market_observations
  nav_snapshots
}

TableGroup office_records {
  bank_accounts
  credit_facilities
  family_members
  vendor_contracts
  deal_pipeline
  committee_decisions
  office_expenses
  corporate_actions
  real_assets
  tax_lots
  tax_obligations
  grants
  staff_payroll
  kyc_records
  fund_holdings
  system_access_grants
  entity_ownership
}

TableGroup rules_and_benchmarks {
  business_rules
  rule_versions
  benchmark_definitions
  benchmark_components
}

TableGroup intents_and_outputs {
  decision_intents
  metric_definitions
  calculation_runs
  metric_values
  metric_evidence
  reports
  report_versions
}

TableGroup exceptions_and_pulse {
  exceptions
  exception_impacts
  exception_events
  approvals
  pulse_items
}

TableGroup agents {
  agent_runs
}
